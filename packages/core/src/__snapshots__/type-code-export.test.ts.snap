// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateCssExport > snapshot stability 1`] = `
"/* Type Scale — Custom — 1.272 */
:root {
  /* Font Families */
  --font-heading: 'Satoshi', sans-serif;
  --font-body: 'Satoshi', sans-serif;
  --font-mono: ui-monospace, 'Cascadia Code', Consolas, 'SF Mono', Menlo, 'DejaVu Sans Mono', monospace;

  /* Font Weights */
  --font-weight-heading: 500;

  /* Type Scale */
  --text-display: 4.2357rem;
  --text-h1: 3.3299rem;
  --text-h2: 2.6179rem;
  --text-h3: 2.0581rem;
  --text-h4: 1.618rem;
  --text-h5: 1.272rem;
  --text-h6: 1rem;
  --text-body-l: 1.618rem;
  --text-body-m: 1.272rem;
  --text-body-s: 1rem;
  --text-caption: 0.7862rem;

  /* Line Heights */
  --leading-display: 1.05;
  --leading-h1: 1.1;
  --leading-h2: 1.15;
  --leading-h3: 1.2;
  --leading-h4: 1.25;
  --leading-h5: 1.3;
  --leading-h6: 1.4;
  --leading-body-l: 1.5;
  --leading-body-m: 1.5;
  --leading-body-s: 1.5;
  --leading-caption: 1.4;

  /* Letter Spacing */
  --tracking-display: -0.04em;
  --tracking-h1: -0.03em;
  --tracking-h2: -0.02em;
  --tracking-h3: -0.01em;
  --tracking-h4: 0em;
  --tracking-h5: 0em;
  --tracking-h6: 0em;
  --tracking-body-l: 0em;
  --tracking-body-m: 0em;
  --tracking-body-s: 0.01em;
  --tracking-caption: 0.01em;
}

/* Text roles: set text through a role, not through single sizes */
.text-role-title-1 {
  font-family: var(--font-heading);
  font-size: var(--text-h1);
  line-height: var(--leading-h1);
  letter-spacing: var(--tracking-h1);
  font-weight: var(--font-weight-heading);
}
.text-role-title-2 {
  font-family: var(--font-heading);
  font-size: var(--text-h3);
  line-height: var(--leading-h3);
  letter-spacing: var(--tracking-h3);
  font-weight: var(--font-weight-heading);
}
.text-role-title-3 {
  font-family: var(--font-heading);
  font-size: var(--text-h5);
  line-height: var(--leading-h5);
  letter-spacing: var(--tracking-h5);
  font-weight: var(--font-weight-heading);
}
.text-role-figure {
  font-family: var(--font-body);
  font-size: var(--text-h2);
  line-height: var(--leading-h2);
  letter-spacing: var(--tracking-h2);
  font-weight: 400;
  font-variant-numeric: tabular-nums;
}
.text-role-body {
  font-family: var(--font-body);
  font-size: var(--text-body-m);
  line-height: var(--leading-body-m);
  letter-spacing: var(--tracking-body-m);
  font-weight: 400;
}
.text-role-label {
  font-family: var(--font-body);
  font-size: var(--text-body-s);
  line-height: var(--leading-body-s);
  letter-spacing: var(--tracking-body-s);
  font-weight: 500;
}
.text-role-meta {
  font-family: var(--font-body);
  font-size: var(--text-caption);
  line-height: var(--leading-caption);
  letter-spacing: var(--tracking-caption);
  font-weight: 400;
}
"
`;

