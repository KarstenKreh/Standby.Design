{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["../core/src/*"],
      "@syslib/*": ["../../system-react/src/lib/*"]
    }
  },
  "include": ["src"]
}
